{
  "name": "node-decision-model",
  "version": "0.3.1",
  "description": "The decision-model interface for Node.js. Ask typed questions about a state and get calibrated probabilities back, via OpenRouter or Typesafe.",
  "keywords": [
    "decision-model",
    "typesafe",
    "jev",
    "openrouter",
    "system-one",
    "classification",
    "probability",
    "ai",
    "cli"
  ],
  "license": "MIT",
  "author": "Fraser Xu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fraserxu/node-decision-model.git"
  },
  "bugs": {
    "url": "https://github.com/fraserxu/node-decision-model/issues"
  },
  "homepage": "https://github.com/fraserxu/node-decision-model#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "decision-model": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node --env-file-if-exists=.env scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
